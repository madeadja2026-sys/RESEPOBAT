/** Backend awal Google Apps Script untuk RESEP OBAT HARIAN. */
const SHEET_NAME='Resep';
const HEADERS=['id','tanggal','nomor','unit','penulis','obat','jumlah','dosis','status','catatan','createdAt','updatedAt'];
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,app:'RESEP OBAT HARIAN',message:'API aktif'})).setMimeType(ContentService.MimeType.JSON)}
function setupSheet(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Isi Script Property SPREADSHEET_ID.');const ss=SpreadsheetApp.openById(id);let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);return 'Sheet siap: '+sh.getName()}
function getSheet_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('SPREADSHEET_ID belum dikonfigurasi.');const sh=SpreadsheetApp.openById(id).getSheetByName(SHEET_NAME);if(!sh)throw new Error('Jalankan setupSheet() dahulu.');return sh}
function listRecords(){const values=getSheet_().getDataRange().getValues();if(values.length<2)return [];const heads=values.shift();return values.filter(r=>r[0]).map(r=>Object.fromEntries(heads.map((h,i)=>[h,r[i] instanceof Date?Utilities.formatDate(r[i],Session.getScriptTimeZone(),'yyyy-MM-dd'):r[i]])))}
function saveRecord(record){if(!record||!record.id||!record.nomor||!record.tanggal||!record.obat)throw new Error('id, nomor, tanggal, obat wajib diisi.');if(!Number.isFinite(Number(record.jumlah))||Number(record.jumlah)<1)throw new Error('Jumlah minimal 1.');const lock=LockService.getScriptLock();lock.waitLock(10000);try{const sh=getSheet_(),values=sh.getDataRange().getValues(),now=new Date();const row=[String(record.id),String(record.tanggal),String(record.nomor),String(record.unit||''),String(record.penulis||''),String(record.obat),Number(record.jumlah),String(record.dosis||''),String(record.status||'Menunggu'),String(record.catatan||''),record.createdAt||now,now];const idx=values.findIndex((r,i)=>i>0&&String(r[0])===String(record.id));if(idx>0)sh.getRange(idx+1,1,1,HEADERS.length).setValues([row]);else sh.appendRow(row);return {ok:true,id:record.id}}finally{lock.releaseLock()}}
function deleteRecord(id){if(!id)throw new Error('ID wajib diisi.');const sh=getSheet_(),values=sh.getDataRange().getValues(),idx=values.findIndex((r,i)=>i>0&&String(r[0])===String(id));if(idx<1)return {ok:false,message:'Data tidak ditemukan.'};sh.deleteRow(idx+1);return {ok:true,id:id}}
